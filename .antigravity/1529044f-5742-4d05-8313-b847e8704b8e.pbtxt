    instruction: "Update index.css with Sophisticated Dark theme custom variables, typography, glassmorphism and glow styles"
    replacement_infos {
      original_chunk {
        target_content: "@import \"tailwindcss\";\n@import url(\'https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&family=Inter:wght@300;400;500;600;700&display=swap\');\n@import url(\'https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\');\n\n:root {\n  --font-display: \'Montserrat\', sans-serif;\n  --font-body: \'Inter\', sans-serif;\n}\n\nbody {\n  font-family: var(--font-body);\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n/* Dark Mode (Electric Cinema Default) */\nhtml.dark {\n  --bg-main: #0b1326;\n  --bg-surface: #131b2e;\n  --bg-surface-high: #222a3d;\n  --text-main: #dae2fd;\n  --text-muted: #cbc3d7;\n  --color-primary: #d0bcff;\n  --color-secondary: #ffb0cd;\n  --color-tertiary: #ceee93;\n  --glass-bg: rgba(11, 19, 38, 0.45);\n  --glass-border: rgba(255, 255, 255, 0.12);\n  --scrim-color: linear-gradient(to top, rgba(11, 19, 38, 1) 0%, rgba(11, 19, 38, 0.75) 50%, rgba(11, 19, 38, 0) 100%);\n  color-scheme: dark;\n}\n\n/* Light Mode */\nhtml:not(.dark) {\n  --bg-main: #f4f6fc;\n  --bg-surface: #ffffff;\n  --bg-surface-high: #e8ecf8;\n  --text-main: #0b1326;\n  --text-muted: #4a5568;\n  --color-primary: #6d3bd7;\n  --color-secondary: #d90266;\n  --color-tertiary: #4a7a00;\n  --glass-bg: rgba(255, 255, 255, 0.75);\n  --glass-border: rgba(0, 0, 0, 0.08);\n  --scrim-color: linear-gradient(to top, rgba(244, 246, 252, 1) 0%, rgba(244, 246, 252, 0.75) 50%, rgba(244, 246, 252, 0) 100%);\n  color-scheme: light;\n}\n\n/* Glassmorphism utility */\n.glass-overlay, .glass-panel {\n  background: var(--glass-bg);\n  backdrop-filter: blur(24px);\n  -webkit-backdrop-filter: blur(24px);\n  border: 1px solid var(--glass-border);\n}\n\n.scrim-bottom {\n  background: var(--scrim-color);\n}\n\n.hero-gradient {\n  background: linear-gradient(180deg, rgba(11,19,38,0) 0%, rgba(11,19,38,0.5) 50%, rgba(11,19,38,1) 100%);\n}\n\nhtml:not(.dark) .hero-gradient {\n  background: linear-gradient(180deg, rgba(244,246,252,0) 0%, rgba(244,246,252,0.5) 50%, rgba(244,246,252,1) 100%);\n}\n\n.glow-active {\n  box-shadow: 0 0 18px rgba(208, 188, 255, 0.4);\n}\n\n.neon-glow {\n  box-shadow: 0 0 15px rgba(255, 176, 205, 0.35);\n}\n\n.gradient-progress {\n  background: linear-gradient(90deg, #d0bcff 0%, #ffb0cd 100%);\n}\n\n/* Custom Scrollbar Hiding */\n.hide-scrollbar::-webkit-scrollbar,\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n\n.hide-scrollbar,\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n/* Font helpers */\n.font-display {\n  font-family: var(--font-display);\n}\n\n/* Material symbol baseline style */\n.material-symbols-outlined {\n  font-variation-settings: \'FILL\' 0, \'wght\' 400, \'GRAD\' 0, \'opsz\' 24;\n  display: inline-block;\n  vertical-align: middle;\n}"
        replacement_content: "@import \"tailwindcss\";\n@import url(\'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,700&family=Inter:wght@300;400;500;600;700&display=swap\');\n@import url(\'https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\');\n\n@theme {\n  --color-background: var(--bg-main);\n  --color-surface: var(--bg-surface);\n  --color-surface-bright: var(--bg-surface-high);\n  --color-surface-variant: var(--bg-surface-high);\n  --color-on-background: var(--text-main);\n  --color-on-surface: var(--text-main);\n  --color-on-surface-variant: var(--text-muted);\n  --color-primary: var(--color-primary);\n  --color-secondary: var(--color-secondary);\n  --color-tertiary: var(--color-tertiary);\n  --color-outline-variant: var(--color-border);\n  --font-serif: \'Playfair Display\', Georgia, serif;\n  --font-display: \'Playfair Display\', Georgia, serif;\n  --font-body: \'Inter\', sans-serif;\n}\n\n:root {\n  --font-display: \'Playfair Display\', Georgia, serif;\n  --font-body: \'Inter\', sans-serif;\n}\n\nbody {\n  font-family: var(--font-body);\n  transition: background-color 0.3s ease, color 0.3s ease;\n  background-color: var(--bg-main);\n  color: var(--text-main);\n}\n\n/* Dark Mode (Sophisticated Dark Default) */\nhtml.dark {\n  --bg-main: #0A0A0A;\n  --bg-surface: #141414;\n  --bg-surface-high: #1E1E1E;\n  --text-main: #EAEAEA;\n  --text-muted: #888888;\n  --color-primary: #C5A368;\n  --color-secondary: #D4AF37;\n  --color-tertiary: #E5C158;\n  --color-border: #222222;\n  --glass-bg: rgba(20, 20, 20, 0.75);\n  --glass-border: rgba(197, 163, 104, 0.2);\n  --scrim-color: linear-gradient(to top, rgba(10, 10, 10, 1) 0%, rgba(10, 10, 10, 0.8) 50%, rgba(10, 10, 10, 0) 100%);\n  color-scheme: dark;\n}\n\n/* Light Mode (Sophisticated Gold/Cream) */\nhtml:not(.dark) {\n  --bg-main: #F7F5F0;\n  --bg-surface: #FFFFFF;\n  --bg-surface-high: #EFECE6;\n  --text-main: #141414;\n  --text-muted: #666666;\n  --color-primary: #9E7B3B;\n  --color-secondary: #B8860B;\n  --color-tertiary: #8B6508;\n  --color-border: #E0DACB;\n  --glass-bg: rgba(255, 255, 255, 0.85);\n  --glass-border: rgba(158, 123, 59, 0.2);\n  --scrim-color: linear-gradient(to top, rgba(247, 245, 240, 1) 0%, rgba(247, 245, 240, 0.8) 50%, rgba(247, 245, 240, 0) 100%);\n  color-scheme: light;\n}\n\n/* Glassmorphism utility */\n.glass-overlay, .glass-panel {\n  background: var(--glass-bg);\n  backdrop-filter: blur(24px);\n  -webkit-backdrop-filter: blur(24px);\n  border: 1px solid var(--glass-border);\n}\n\n.scrim-bottom {\n  background: var(--scrim-color);\n}\n\n.hero-gradient {\n  background: linear-gradient(180deg, rgba(10,10,10,0) 0%, rgba(10,10,10,0.6) 50%, rgba(10,10,10,1) 100%);\n}\n\nhtml:not(.dark) .hero-gradient {\n  background: linear-gradient(180deg, rgba(247,245,240,0) 0%, rgba(247,245,240,0.6) 50%, rgba(247,245,240,1) 100%);\n}\n\n.glow-active {\n  box-shadow: 0 0 18px rgba(197, 163, 104, 0.35);\n}\n\n.neon-glow {\n  box-shadow: 0 0 20px rgba(197, 163, 104, 0.25);\n}\n\n.gradient-progress {\n  background: linear-gradient(90deg, #C5A368 0%, #E5C158 100%);\n}\n\n/* Custom Scrollbar Hiding */\n.hide-scrollbar::-webkit-scrollbar,\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n\n.hide-scrollbar,\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n/* Font helpers */\n.font-display {\n  font-family: var(--font-display);\n}\n\n/* Material symbol baseline style */\n.material-symbols-outlined {\n  font-variation-settings: \'FILL\' 0, \'wght\' 400, \'GRAD\' 0, \'opsz\' 24;\n  display: inline-block;\n  vertical-align: middle;\n}\n"
      }
      num_matches: 1
    }
  }
}
