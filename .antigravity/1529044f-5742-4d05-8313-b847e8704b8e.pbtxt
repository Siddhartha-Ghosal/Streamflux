        target_content: "export const MovieCard: React.FC<MovieCardProps> = ({\n  movie,\n  aspectRatio = \'portrait\',\n  className = \'\',\n  showProgress = false,\n}) => {\n  const { openMovieDetails, openPlayer, isInWatchlist, toggleWatchlist } = useApp();\n  const inList = isInWatchlist(movie.id);\n\n  return (\n    <div\n      onClick={() => openMovieDetails(movie)}\n      className={`group cursor-pointer flex-none relative snap-start transition-all duration-300 ${className}`}\n    >\n      <div\n        className={`relative w-full rounded-xl overflow-hidden glass-panel group-hover:neon-glow group-hover:scale-105 transition-all duration-300 ${\n          aspectRatio === \'portrait\' ? \'aspect-[2/3]\' : \'aspect-video\'\n        }`}\n      >\n        <img\n          src={aspectRatio === \'portrait\' ? movie.posterUrl : movie.backdropUrl || movie.posterUrl}\n          alt={movie.title}\n          className=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\"\n          loading=\"lazy\"\n        />\n\n        {/* Gradient Scrim */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-transparent opacity-80 group-hover:opacity-60 transition-opacity\" />\n\n        {/* Top Badges */}\n        <div className=\"absolute top-2 left-2 right-2 flex justify-between items-center z-10 pointer-events-none\">\n          {movie.isNew ? (\n            <span className=\"bg-secondary/90 text-background font-bold text-[10px] px-2 py-0.5 rounded-full shadow-sm\">\n              NEW\n            </span>\n          ) : movie.is4K ? (\n            <span className=\"bg-primary/20 border border-primary/40 text-primary font-bold text-[10px] px-2 py-0.5 rounded-full backdrop-blur-sm\">\n              4K\n            </span>\n          ) : <span />}\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              toggleWatchlist(movie.id);\n            }}\n            className=\"pointer-events-auto p-1.5 rounded-full glass-overlay text-white hover:text-secondary transition-colors\"\n            title={inList ? \'Remove from My List\' : \'Add to My List\'}\n          >\n            <span\n              className=\"material-symbols-outlined text-sm\"\n              style={{ fontVariationSettings: inList ? \"\'FILL\' 1\" : \"\'FILL\' 0\" }}\n            >\n              {inList ? \'bookmark_added\' : \'add\'}\n            </span>\n          </button>\n        </div>\n\n        {/* Hover Play Button */}\n        <div className=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/40\">\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              openPlayer(movie);\n            }}\n            className=\"w-12 h-12 rounded-full bg-primary text-background flex items-center justify-center neon-glow hover:scale-110 transition-transform\"\n          >\n            <span className=\"material-symbols-outlined text-2xl\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>\n              play_arrow\n            </span>\n          </button>\n        </div>\n\n        {/* Bottom Info Rating */}\n        <div className=\"absolute bottom-2 left-2 right-2 flex items-center justify-between text-xs text-white z-10\">\n          <div className=\"flex items-center gap-1 font-semibold\">\n            <span className=\"material-symbols-outlined text-primary text-sm\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>\n              star\n            </span>\n            <span>{movie.rating}</span>\n          </div>\n          <span className=\"text-[10px] opacity-80\">{movie.duration}</span>\n        </div>\n      </div>\n\n      {/* Movie Title */}\n      <h4 className=\"font-label-lg text-xs font-semibold text-on-surface truncate mt-1.5 group-hover:text-primary transition-colors\">\n        {movie.title}\n      </h4>\n\n      {/* Progress Bar for Continue Watching */}\n      {showProgress && movie.watchProgress !== undefined && (\n        <div className=\"w-full h-1 bg-surface-container-highest rounded-full overflow-hidden mt-1\">\n          <div\n            className=\"h-full gradient-progress rounded-full shadow-[0_0_8px_rgba(255,176,205,0.8)]\"\n            style={{ width: `${movie.watchProgress}%` }}\n          />\n        </div>\n      )}\n    </div>\n  );\n};"
        replacement_content: "export const MovieCard: React.FC<MovieCardProps> = ({\n  movie,\n  aspectRatio = \'portrait\',\n  className = \'\',\n  showProgress = false,\n}) => {\n  const { openMovieDetails, openPlayer, isInWatchlist, toggleWatchlist } = useApp();\n  const inList = isInWatchlist(movie.id);\n\n  return (\n    <div\n      onClick={() => openMovieDetails(movie)}\n      className={`group cursor-pointer flex-none relative snap-start transform hover:-translate-y-1.5 hover:scale-[1.03] transition-all duration-300 ease-out ${className}`}\n    >\n      <div\n        className={`relative w-full rounded-2xl overflow-hidden glass-panel border border-white/10 group-hover:border-primary/60 group-hover:shadow-[0_12px_30px_rgba(197,163,104,0.3)] transition-all duration-300 ${\n          aspectRatio === \'portrait\' ? \'aspect-[2/3]\' : \'aspect-video\'\n        }`}\n      >\n        <img\n          src={aspectRatio === \'portrait\' ? movie.posterUrl : movie.backdropUrl || movie.posterUrl}\n          alt={movie.title}\n          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out\"\n          loading=\"lazy\"\n        />\n\n        {/* Gradient Scrim */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-background/95 via-background/20 to-transparent opacity-80 group-hover:opacity-50 transition-opacity duration-300\" />\n\n        {/* Top Badges */}\n        <div className=\"absolute top-2.5 left-2.5 right-2.5 flex justify-between items-center z-10 pointer-events-none\">\n          {movie.isNew ? (\n            <span className=\"bg-secondary text-background font-extrabold text-[10px] px-2.5 py-0.5 rounded-full shadow-md tracking-wider\">\n              NEW \360\237\214\237\n            </span>\n          ) : movie.is4K ? (\n            <span className=\"bg-primary/20 border border-primary/50 text-primary font-extrabold text-[10px] px-2.5 py-0.5 rounded-full backdrop-blur-md shadow-sm\">\n              4K HDR\n            </span>\n          ) : <span />}\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              toggleWatchlist(movie.id);\n            }}\n            className=\"pointer-events-auto p-1.5 rounded-full glass-overlay text-white hover:text-secondary hover:bg-black/50 transition-all active:scale-90\"\n            title={inList ? \'Remove from My List\' : \'Add to My List\'}\n          >\n            <span\n              className=\"material-symbols-outlined text-base\"\n              style={{ fontVariationSettings: inList ? \"\'FILL\' 1\" : \"\'FILL\' 0\" }}\n            >\n              {inList ? \'bookmark_added\' : \'add\'}\n            </span>\n          </button>\n        </div>\n\n        {/* Hover Play Button Overlay with Play Sign & Text */}\n        <div className=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/40 backdrop-blur-[2px]\">\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              openPlayer(movie);\n            }}\n            className=\"px-4 py-2 rounded-full bg-primary text-background font-extrabold text-xs tracking-wider uppercase flex items-center gap-1.5 neon-glow hover:scale-110 transition-all shadow-2xl active:scale-95\"\n          >\n            <span className=\"material-symbols-outlined text-lg\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>\n              play_arrow\n            </span>\n            <span>PLAY</span>\n          </button>\n        </div>\n\n        {/* Bottom Info Rating */}\n        <div className=\"absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between text-xs text-white z-10\">\n          <div className=\"flex items-center gap-1 font-bold bg-black/40 px-2 py-0.5 rounded-md backdrop-blur-sm\">\n            <span className=\"material-symbols-outlined text-primary text-sm\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>\n              star\n            </span>\n            <span>{movie.rating}</span>\n          </div>\n          <span className=\"text-[10px] font-semibold text-white/90 bg-black/40 px-2 py-0.5 rounded-md backdrop-blur-sm\">\n            {movie.duration}\n          </span>\n        </div>\n      </div>\n\n      {/* Movie Title */}\n      <h4 className=\"font-label-lg text-xs font-bold text-on-surface truncate mt-2 group-hover:text-primary transition-colors\">\n        {movie.title}\n      </h4>\n\n      {/* Progress Bar for Continue Watching */}\n      {showProgress && movie.watchProgress !== undefined && (\n        <div className=\"w-full h-1.5 bg-surface-variant/50 rounded-full overflow-hidden mt-1.5\">\n          <div\n            className=\"h-full gradient-progress rounded-full shadow-[0_0_8px_rgba(197,163,104,0.8)]\"\n            style={{ width: `${movie.watchProgress}%` }}\n          />\n        </div>\n      )}\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
